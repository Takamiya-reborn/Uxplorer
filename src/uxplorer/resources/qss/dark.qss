QMainWindow,
QListView#fileList {
    background: #202020;
}

QToolBar {
    background: #202020;
    border: none;
    border-bottom: 1px solid #383838;
    padding: 5px 8px;
    spacing: 4px;
}
QToolBar::separator {
    background: #3b3b3b;
    width: 1px;
    margin: 6px 4px;
}
QToolButton {
    border: none;
    border-radius: 5px;
    padding: 5px 10px;
    background: transparent;
    color: #e5e5e5;
}
QToolButton:hover {
    background: #333333;
}
QToolButton:pressed {
    background: #404040;
}
QToolButton:checked {
    background: #264f78;
    color: #ffffff;
}
QToolButton:disabled {
    color: #777777;
}

QLineEdit#searchBox,
QComboBox {
    border: 1px solid #555555;
    border-radius: 4px;
    padding: 4px 10px;
    background: #2b2b2b;
    color: #f2f2f2;
    selection-background-color: #264f78;
}
QLineEdit#searchBox:focus,
QComboBox:focus {
    border-color: #3794ff;
}
QComboBox {
    padding: 3px 26px 3px 10px;
}
QComboBox:hover,
QLineEdit#searchBox:hover {
    border-color: #707070;
}
QComboBox::drop-down {
    border: none;
    width: 20px;
}
QComboBox::down-arrow {
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #bdbdbd;
    margin-right: 8px;
}
QComboBox QAbstractItemView {
    border: 1px solid #555555;
    border-radius: 4px;
    background: #2b2b2b;
    color: #f2f2f2;
    selection-background-color: #264f78;
    selection-color: #ffffff;
    outline: none;
}
QMenu {
    border: 1px solid #555555;
    border-radius: 8px;
    padding: 6px;
    background: #2b2b2b;
    color: #f2f2f2;
}
QMenu::item {
    padding: 6px 28px 6px 12px;
    border-radius: 4px;
}
QMenu::item:selected {
    background: #264f78;
    color: #ffffff;
}
QMenu::separator {
    height: 1px;
    margin: 4px 8px;
    background: #444444;
}

QWidget#pathRow {
    background: #202020;
    border-bottom: 1px solid #383838;
}
QWidget#fileHeader {
    background: #292929;
    border-bottom: 1px solid #3d3d3d;
}
QPushButton#crumbButton {
    border: none;
    border-radius: 4px;
    padding: 2px 6px;
    background: transparent;
    color: #cccccc;
}
QPushButton#crumbButton:hover {
    background: #383838;
    color: #ffffff;
}
QLabel#crumbSep {
    color: #888888;
}
QLabel#crumbCurrent {
    color: #f2f2f2;
    font-weight: 600;
    padding: 2px 6px;
}

QListView#fileList {
    /* 不能加边框：视口左缘必须与表头左缘重合，否则行内容会整体偏移 */
    border: none;
    outline: none;
}
QListView#fileList::item {
    background: transparent;
    border: none;
}
QLabel#emptyState {
    color: #999999;
    font-size: 14px;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}
QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background: #5a5a5a;
    border-radius: 5px;
}
QScrollBar::handle:vertical {
    min-height: 30px;
}
QScrollBar::handle:horizontal {
    min-width: 30px;
}
QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background: #707070;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0;
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

QStatusBar {
    border-top: 1px solid #383838;
    background: #202020;
    color: #aaaaaa;
}
QStatusBar QLabel {
    color: #aaaaaa;
    padding: 0 8px;
}

QToolTip {
    background: #2b2b2b;
    border: 1px solid #555555;
    color: #f2f2f2;
    padding: 4px 6px;
}
