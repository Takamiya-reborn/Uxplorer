QMainWindow,
QListView#fileList {
    background: #f3f3f3;
}

QToolBar {
    background: #f3f3f3;
    border: none;
    border-bottom: 1px solid #dedede;
    padding: 5px 8px;
    spacing: 4px;
}
QToolBar::separator {
    background: #d6d6d6;
    width: 1px;
    margin: 6px 4px;
}
QToolButton {
    border: none;
    border-radius: 5px;
    padding: 5px 10px;
    background: transparent;
    color: #333333;
}
QToolButton:hover {
    background: #e5e5e5;
}
QToolButton:pressed {
    background: #d8d8d8;
}
QToolButton:checked {
    background: #dbeafe;
    color: #005fb8;
}
QToolButton:disabled {
    color: #a0a0a0;
}

QLineEdit#searchBox,
QComboBox {
    border: 1px solid #c8c8c8;
    border-radius: 4px;
    padding: 4px 10px;
    background: white;
    color: #1f1f1f;
}
QLineEdit#searchBox:focus,
QComboBox:focus {
    border-color: #0067c0;
}
QComboBox {
    padding: 3px 26px 3px 10px;
}
QComboBox:hover,
QLineEdit#searchBox:hover {
    border-color: #a8a8a8;
}
QComboBox::drop-down {
    border: none;
    width: 20px;
}
QComboBox::down-arrow {
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #777777;
    margin-right: 8px;
}
QComboBox QAbstractItemView {
    border: 1px solid #c8c8c8;
    border-radius: 4px;
    background: white;
    color: #1f1f1f;
    selection-background-color: #dbeafe;
    selection-color: #1f1f1f;
    outline: none;
}
QMenu {
    border: 1px solid #c8c8c8;
    padding: 4px;
    background: white;
    color: #1f1f1f;
}
QMenu::item {
    padding: 6px 28px 6px 24px;
    border-radius: 3px;
}
QMenu::item:selected {
    background: #dbeafe;
    color: #1f1f1f;
}
QMenu::separator {
    height: 1px;
    margin: 4px 8px;
    background: #dedede;
}

QWidget#pathRow {
    background: #f3f3f3;
    border-bottom: 1px solid #dedede;
}
QWidget#fileHeader {
    background: #f8f8f8;
    border-bottom: 1px solid #dedede;
}
QPushButton#crumbButton {
    border: none;
    border-radius: 4px;
    padding: 2px 6px;
    background: transparent;
    color: #4f4f4f;
}
QPushButton#crumbButton:hover {
    background: #e5e5e5;
    color: #1f1f1f;
}
QLabel#crumbSep {
    color: #777777;
}
QLabel#crumbCurrent {
    color: #1f1f1f;
    font-weight: 600;
    padding: 2px 6px;
}

QListView#fileList {
    /* 不能加边框：视口左缘必须与表头左缘重合，否则行内容会整体偏移 */
    border: none;
    outline: none;
}
QListView#fileList::item {
    background: transparent;
    border: none;
}
QLabel#emptyState {
    color: #777777;
    font-size: 14px;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}
QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background: #c7c7c7;
    border-radius: 5px;
}
QScrollBar::handle:vertical {
    min-height: 30px;
}
QScrollBar::handle:horizontal {
    min-width: 30px;
}
QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background: #aaaaaa;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0;
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

QStatusBar {
    border-top: 1px solid #dedede;
    background: #f3f3f3;
    color: #5f6368;
}
QStatusBar QLabel {
    color: #5f6368;
    padding: 0 8px;
}

QToolTip {
    background: #fffef8;
    border: 1px solid #c8c8c8;
    color: #1f1f1f;
    padding: 4px 6px;
}
